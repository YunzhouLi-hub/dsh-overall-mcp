{
  "name": "dsh-overall-mcp",
  "version": "1.0.7",
  "description": "Overall MCP for DeepSeek Harness: first-run host-wide MCP config scan + auto-import, plus live aggregation of open MCP catalogs (official registry / Smithery / Docker MCP / awesome-remote / awesome-mcp-servers) for search and one-click install.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "scanner",
    "catalog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunzhouLi-hub/dsh-overall-mcp.git"
  },
  "homepage": "https://github.com/YunzhouLi-hub/dsh-overall-mcp#readme",
  "bugs": {
    "url": "https://github.com/YunzhouLi-hub/dsh-overall-mcp/issues"
  },
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./lib/scanner.js": "./lib/scanner.js",
    "./lib/catalog.js": "./lib/catalog.js",
    "./lib/catalog-cache.js": "./lib/catalog-cache.js",
    "./lib/server-config.js": "./lib/server-config.js",
    "./lib/custom-sources.js": "./lib/custom-sources.js",
    "./lib/submission.js": "./lib/submission.js",
    "./lib/install-diagnosis.js": "./lib/install-diagnosis.js",
    "./lib/about-i18n.js": "./lib/about-i18n.js",
    "./lib/health.js": "./lib/health.js",
    "./lib/remote-auth.js": "./lib/remote-auth.js",
    "./lib/about.js": "./lib/about.js",
    "./lib/media.js": "./lib/media.js",
    "./lib/skills.js": "./lib/skills.js",
    "./lib/zip.js": "./lib/zip.js",
    "./lib/skill-market.js": "./lib/skill-market.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "docs/images",
    "cordis.patch.yml",
    "registry.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.2-rc.5",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.2 || ^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.2-rc.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
